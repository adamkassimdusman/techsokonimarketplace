# Local persistent PGlite is allowed only with this explicit flag.
LOCAL_DATABASE=1
# Production: PostgreSQL connection owned by a dedicated migration role.
DATABASE_URL=
APP_URL=http://localhost:3000
# Reset emails: configure both values to enable password recovery.
RESEND_API_KEY=
MAIL_FROM=

# Optional absolute local database directory (used by isolated integration tests).
# LOCAL_DATABASE_PATH=/absolute/path/to/disposable/postgres
